# Maison Momento — Environment Variables Reference
# -------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# .env is already listed in .gitignore.

# ── Core Django ──────────────────────────────────────────────────────────────

# Generate a secure key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=django-insecure-local-dev-only-do-not-use-in-production

# Set to False in production. Any value other than "True" is treated as False.
DJANGO_DEBUG=True

# Comma-separated list of hostnames Django will serve.
# Example: DJANGO_ALLOWED_HOSTS=maisonmomento.com,www.maisonmomento.com
# Leave blank to use the localhost default when DJANGO_DEBUG=True.
DJANGO_ALLOWED_HOSTS=

# ── Database ─────────────────────────────────────────────────────────────────

DB_NAME=maison_momento
DB_USER=tanaya
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional: set to an integer (seconds) to enable persistent DB connections.
# DB_CONN_MAX_AGE=60

# ── Static & Media ───────────────────────────────────────────────────────────

# Leave blank to use the defaults (/static/ and /media/).
# Override with a CDN base URL when using cloud storage.
STATIC_URL=/static/
MEDIA_URL=/media/

# ── Future: Cloud Storage ────────────────────────────────────────────────────
# Uncomment and set when adding django-storages + S3/GCS.

# DJANGO_DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
# DJANGO_STATICFILES_STORAGE=storages.backends.s3boto3.S3StaticStorage
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-south-1
# AWS_S3_CUSTOM_DOMAIN=

# ── Application ───────────────────────────────────────────────────────────────

LOW_STOCK_THRESHOLD=5
